{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Personal app catalog entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "repository", "owner", "status", "tracking_issue", "exceptions"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/"},
    "owner": {"type": "string", "minLength": 1},
    "status": {"enum": ["planned", "in-progress", "adopted"]},
    "tracking_issue": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/"},
    "exceptions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["scope", "reason", "owner", "review_date", "issue"], "properties": {"scope": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1}, "review_date": {"type": "string", "format": "date"}, "issue": {"type": "string", "format": "uri"}}}}
  }
}
